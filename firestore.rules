rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FUNCIÓN: Verificar autenticación
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ============================================
    // Colección de configuración
    // ============================================
    match /config/{docId} {
      // Permitir lectura del hash para validación en frontend
      allow read: if true;
      // Nadie puede escribir (solo admin manual)
      allow write: if false;
    }
    
    // ============================================
    // Tokens de acceso
    // ============================================
    match /accessTokens/{tokenId} {
      // Solo Cloud Functions pueden leer/escribir
      allow read, write: if false;
    }
    
    // ============================================
    // Perfiles de usuarios
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false; // No permitir eliminar perfiles
    }
    
    // ============================================
    // Publicaciones
    // ============================================
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['authorId', 'content', 'timestamp']);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // ============================================
    // Bloquear todo lo demás
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}